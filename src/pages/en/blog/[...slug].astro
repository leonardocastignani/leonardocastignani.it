---
// --- IMPORTS ---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getReadingTime } from '../../../scripts/readingTime.js';

// --- STATIC PATH GENERATION ---
export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => data.lang === 'en');
    return posts.map((post: CollectionEntry<'blog'>) => {
        const cleanSlug = post.slug.replace(/^en\//, '');
        return {
            params: { slug: cleanSlug },
            props: post,
        };
    });
}

// --- PROPS ---
type Props = CollectionEntry<'blog'>;

// --- INITIAL CONFIGURATION ---
const post = Astro.props;
const { Content, headings } = await post.render();
const readingTime = getReadingTime(post.body);
---

<!-- RENDER BLOG POST LAYOUT -->
<BlogPost {...post.data} slug={post.slug} readingTime={readingTime} headings={headings}>
    <Content />
</BlogPost>