---
// --- IMPORTS ---
import Layout from '../../../layouts/Layout.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import ServicesQuiz from '../../../components/services/ServicesQuiz.astro';
import ServiceModal from '../../../components/services/ServiceModal.astro';
import BeforeAfterStats from '../../../components/services/BeforeAfterStats.astro';
import TerminalDemo from '../../../components/services/TerminalDemo.astro';
import CostEstimator from '../../../components/services/CostEstimator.astro';
import ProcessSteps from '../../../components/services/ProcessSteps.astro';
import FAQ from '../../../components/FAQ.astro';
import Maintenance from '../../../components/Maintenance.astro';
import { getI18N } from '../../../i18n/utils';
import { SITE_DATA, SCHEMA_IDS, MAINTENANCE_MODE } from '../../../consts';
import type { ServiceIconName } from '../../../types/services';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const services = i18n.services;

// --- SEO & CANONICAL ---
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateIt = new URL('/servizi/', Astro.site);

// --- JSON-LD: SERVICES + BREADCRUMB ---
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_DATA.siteUrl}/en/` },
                { "@type": "ListItem", "position": 2, "name": services.title, "item": canonicalURL.toString() }
            ]
        },
        ...services.list.map((service) => ({
            "@type": "Service",
            "name": service.title,
            "description": service.description,
            "provider": { "@id": SCHEMA_IDS.organization },
            "areaServed": { "@type": "Country", "name": "Italy" },
            "serviceType": service.title
        }))
    ]
};
---

{/* MAINTENANCE MODE CHECK */}
{MAINTENANCE_MODE ? (
    <Maintenance lang="en" />
) : (
    <Layout title={services.metaTitle} description={services.metaDescription} alternateIt={alternateIt}>

        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

        <main class="pt-24 pb-16 px-4 bg-gray-900 min-h-screen">
            <div class="container mx-auto max-w-5xl">

                {/* PAGE HEADER */}
                <div class="text-center mb-16" data-animate="fade-up">
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-5">{services.title}</h1>
                    <p class="text-gray-400 text-lg max-w-2xl mx-auto">{services.subtitle}</p>
                </div>

                {/* INTERACTIVE QUIZ / CONFIGURATOR */}
                <ServicesQuiz />

                {/* SERVICES GRID (click a card for full detail; flexbox so an odd last card centers instead of breaking symmetry) */}
                <div class="flex flex-wrap justify-center gap-8 mb-24" data-stagger-children="100">
                    {services.list.map((service) => (
                        <div class="w-full md:w-[calc(50%-1rem)]">
                            <ServiceCard
                                slug={service.slug}
                                icon={service.icon as ServiceIconName}
                                title={service.title}
                                tagline={service.tagline}
                                description={service.description}
                                features={service.features}
                                idealFor={service.idealFor}
                                includes={service.includes}
                                detailsLabel={services.detailsLabel}
                            />
                        </div>
                    ))}
                </div>
                <ServiceModal />

                {/* BEFORE / AFTER ANIMATED STATS */}
                <BeforeAfterStats />

                {/* LIVE TERMINAL DEMO */}
                <TerminalDemo />

                {/* INTERACTIVE COST ESTIMATOR */}
                <CostEstimator />

                {/* PROCESS: HOW I WORK */}
                <ProcessSteps />

                {/* FAQ (shared with homepage FAQ content) */}
                <FAQ items={i18n.homeFaq.items} lang="en" title={services.faqTitle} />

                {/* COMMERCIAL CTA */}
                <div class="mt-16 p-6 md:p-8 rounded-xl border border-blue-500/30 bg-gradient-to-br from-blue-950/40 to-purple-950/20 text-center" data-animate="scale">
                    <h2 class="text-xl md:text-2xl font-bold text-white">{services.ctaTitle}</h2>
                    <p class="mt-2 text-gray-300 max-w-xl mx-auto">{services.ctaText}</p>
                    <a
                        href={services.ctaHref}
                        data-magnetic-strength="0.25"
                        class="btn-premium magnetic inline-block mt-5 bg-blue-600 hover:bg-blue-500 hover:shadow-[0_10px_30px_-8px_rgba(59,130,246,0.55)] text-white font-bold py-3 px-6 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 focus-visible:ring-white"
                    >
                        {services.ctaButton}
                    </a>
                </div>

            </div>
        </main>
    </Layout>
)}
