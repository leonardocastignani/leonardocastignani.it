---
// --- IMPORTS ---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { getI18N } from '../i18n/utils';
import { getTagLabel } from '../data/tags';
import Maintenance from '../components/Maintenance.astro';
import FAQ from '../components/FAQ.astro';
import AuthorBox from '../components/AuthorBox.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { MAINTENANCE_MODE, SITE_DATA, SCHEMA_IDS } from '../consts';

// --- PROPS DEFINITION ---
type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & { slug: string; readingTime: number; headings: Heading[] };

// --- INITIAL CONFIGURATION ---
const { title, description, pubDate, updatedDate, heroImage, imageAlt, imageTitle, imageCaption, lang, alternateSlug, faqs, tags, slug, readingTime, headings } = Astro.props;
const i18n = getI18N({ astroUrl: Astro.url });

const backLink = lang === 'en' ? '/en/blog/' : '/blog/';

let alternateIt = undefined;
let alternateEn = undefined;

if (alternateSlug) {
    if (lang === 'it') {
        alternateEn = new URL(`/en/blog/${alternateSlug}/`, Astro.site);
    } else {
        alternateIt = new URL(`/blog/${alternateSlug}/`, Astro.site);
    }
}

// --- JSON-LD SCHEMA CONFIGURATION ---
const defaultImage = new URL('/social-preview.png', Astro.site).toString();
const finalImage = heroImage ? new URL(heroImage, Astro.site).toString() : defaultImage;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  "headline": title,
  "description": description,
  "image": {
    "@type": "ImageObject",
    "url": finalImage,
    "description": imageAlt || description,
    "caption": imageCaption || title
  },
  "author": { "@id": SCHEMA_IDS.person },
  "publisher": { "@id": SCHEMA_IDS.organization },
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "inLanguage": lang === 'it' ? 'it-IT' : 'en-US'
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE_DATA.siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'en' ? "Blog" : "Articoli",
      "item": `${SITE_DATA.siteUrl}${lang === 'en' ? '/en/blog/' : '/blog/'}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": Astro.url.href
    }
  ]
};
---

{/* MAINTENANCE MODE CHECK */}
{MAINTENANCE_MODE ? (
    <Maintenance lang={lang} />
) : (
    <Layout title={title} description={description} image={heroImage} imageAlt={imageAlt || title} alternateIt={alternateIt} alternateEn={alternateEn}>
        
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

        <script>
            import { initBlogEnhancements } from '../scripts/blogEnhancements.js';

            function initBlogPostScripts() {
                try {
                    initBlogEnhancements();
                } catch (e) {
                    console.error("Errore BlogEnhancements:", e);
                }
            }

            document.addEventListener('astro:page-load', initBlogPostScripts);
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initBlogPostScripts);
            } else {
                initBlogPostScripts();
            }
        </script>

        <div class="pt-24 pb-16 px-4 bg-white min-h-screen">
            <article class="container mx-auto max-w-3xl" lang={lang} data-pagefind-body data-pagefind-filter="lang[lang]">
                {/* HERO IMAGE */}
                {heroImage && (
                    <figure class="mb-8 w-full" data-animate="fade">
                        <div class="hero-image-lightbox img-reveal rounded-xl overflow-hidden shadow-2xl aspect-[16/9] w-full bg-slate-50">
                            <img
                                src={heroImage}
                                alt={imageAlt || title}
                                title={imageTitle}
                                class="w-full h-full object-cover"
                                loading="eager"
                                decoding="async"
                                fetchpriority="high"
                                width="1200"
                                height="669"
                            />
                        </div>
                        {imageCaption && (
                            <figcaption class="text-center mt-3 text-sm text-gray-500 italic">
                                {imageCaption}
                            </figcaption>
                        )}
                    </figure>
                )}

                {/* POST HEADER */}
                <div class="mb-8 text-center">
                    <div class="text-gray-500 mb-2">
                        <time datetime={pubDate.toISOString()}>
                            {pubDate.toLocaleDateString(i18n.blog.locale, {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                            })}
                        </time>
                        <span aria-hidden="true"> · </span>
                        <span>{i18n.blog.readingTime.replace('{minutes}', readingTime.toString())}</span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">{title}</h1>

                    {tags && tags.length > 0 && (
                        <div class="flex flex-wrap justify-center gap-2 mt-4">
                            {tags.map((tag) => (
                                <a
                                    href={lang === 'en' ? `/en/blog/tag/${tag}/` : `/blog/tag/${tag}/`}
                                    class="text-xs font-mono px-3 py-1 bg-slate-50 text-blue-600 border border-slate-200 rounded-full hover:bg-slate-100 hover:border-blue-400 hover:-translate-y-0.5 transition-all duration-200 inline-block"
                                >
                                    #{getTagLabel(tag, lang)}
                                </a>
                            ))}
                        </div>
                    )}

                    <hr class="border-slate-200 my-8" />
                </div>
                
                {/* POST CONTENT (Markdown) */}
                <div class="prose prose-lg max-w-none hover:prose-a:text-blue-700 prose-a:text-blue-600 prose-headings:scroll-mt-28 prose-code:text-blue-700 prose-blockquote:border-l-4 prose-blockquote:border-blue-400 prose-blockquote:not-italic prose-blockquote:bg-blue-50/60 prose-blockquote:rounded-r-lg prose-blockquote:py-2">
                    <slot />
                </div>

                {/* SHARE BUTTONS */}
                <ShareButtons title={title} />

                {/* POST AUTHOR (repeated boilerplate: excluded from search index) */}
                <div data-pagefind-ignore>
                    <AuthorBox lang={lang} />
                </div>

                {/* POST FAQS */}
                {faqs && faqs.length > 0 && <FAQ items={faqs} lang={lang} />}

                {/* RELATED ARTICLES (repeated boilerplate: excluded from search index) */}
                <div data-pagefind-ignore>
                    <RelatedPosts lang={lang} currentSlug={slug} tags={tags} />
                </div>

                {/* COMMERCIAL CTA */}
                <div class="mt-10 p-6 md:p-8 rounded-xl border border-blue-500/30 bg-gradient-to-br from-blue-50 to-purple-50 text-center" data-animate="scale" data-pagefind-ignore>
                    <h2 class="text-xl md:text-2xl font-bold text-gray-900">{i18n.blog.ctaTitle}</h2>
                    <p class="mt-2 text-gray-600 max-w-xl mx-auto">{i18n.blog.ctaText}</p>
                    <a
                        href={i18n.blog.ctaHref}
                        data-magnetic-strength="0.25"
                        class="btn-premium magnetic inline-block mt-5 bg-blue-600 hover:bg-blue-500 hover:shadow-[0_10px_30px_-8px_rgba(59,130,246,0.55)] text-white font-bold py-3 px-6 rounded-lg focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:ring-blue-600"
                    >
                        {i18n.blog.ctaButton}
                    </a>
                </div>
            </article>

            {/* POST FOOTER */}
            <div class="text-center mt-12">
                <a href={backLink} class="nav-link-underline text-blue-600 hover:text-blue-700 font-semibold">
                    {i18n.blog.backToArticles}
                </a>
            </div>
        </div>

        {/* TABLE OF CONTENTS */}
        <TableOfContents headings={headings} lang={lang} />
    </Layout>
)}