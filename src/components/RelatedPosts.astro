---
// --- IMPORTS ---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getI18N } from '../i18n/utils';

// --- PROPS ---
interface Props {
    lang: 'it' | 'en';
    currentSlug: string;
    tags?: string[];
}
const { lang, currentSlug, tags = [] } = Astro.props;
const i18n = getI18N({ astroUrl: Astro.url });

// --- RELATED POSTS: shared canonical tags, most in common first, then most recent ---
const allPosts = await getCollection('blog', ({ data }) => data.lang === lang);
const related = allPosts
    .filter((post) => post.slug !== currentSlug)
    .map((post) => ({
        post,
        shared: (post.data.tags ?? []).filter((t: string) => tags.includes(t)).length,
    }))
    .filter((entry) => entry.shared > 0)
    .sort((a, b) => b.shared - a.shared || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
    .slice(0, 3)
    .map((entry) => entry.post);

const prefix = lang === 'en' ? '/en/blog/' : '/blog/';
const stripPrefix = new RegExp(`^${lang}/`);
---

{related.length > 0 && (
    <div class="mt-12 fade-in-section">
        <h2 class="text-2xl font-bold text-white mb-6">{i18n.blog.relatedTitle}</h2>
        <div class="grid gap-6 sm:grid-cols-3" data-stagger-children="90">
            {related.map((post: CollectionEntry<'blog'>) => (
                <a
                    href={`${prefix}${post.slug.replace(stripPrefix, '')}/`}
                    data-animate="fade-up"
                    data-tilt-max="2"
                    class="card-tilt spotlight block group bg-gray-800 rounded-xl overflow-hidden border border-gray-700 hover:border-blue-500 shadow-lg"
                >
                    {post.data.heroImage && (
                        <div class="img-reveal aspect-[16/9] w-full overflow-hidden border-b border-gray-700 bg-gray-800">
                            <img
                                src={post.data.heroImage}
                                alt={post.data.title}
                                class="w-full h-full object-cover"
                                loading="lazy"
                                decoding="async"
                                width="400"
                                height="225"
                            />
                        </div>
                    )}
                    <div class="p-4">
                        <h3 class="font-semibold text-white group-hover:text-blue-400 transition-colors text-sm leading-snug">
                            {post.data.title}
                        </h3>
                    </div>
                </a>
            ))}
        </div>
    </div>
)}