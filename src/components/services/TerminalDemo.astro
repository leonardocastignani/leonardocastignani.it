---
// --- IMPORTS ---
import { getI18N } from '../../i18n/utils';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const terminal = i18n.services.terminal;
---

<!-- ANIMATED TERMINAL DEMO -->
<div class="mb-24" data-animate="fade-up">
    <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">{terminal.title}</h2>
        <p class="text-gray-400 max-w-xl mx-auto">{terminal.subtitle}</p>
    </div>

    <div class="max-w-2xl mx-auto rounded-xl overflow-hidden border border-gray-700 shadow-2xl bg-[#0d1117]">
        <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-800/80 border-b border-gray-700">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            <span class="ml-3 text-xs text-gray-500 font-mono">zsh — build</span>
        </div>
        <pre
            id="terminal-output"
            class="p-5 font-mono text-sm text-green-400 leading-relaxed min-h-[220px] whitespace-pre-wrap"
            aria-hidden="true"
            data-lines={JSON.stringify(terminal.lines)}
        ></pre>
        <p class="sr-only">{terminal.lines.join('\n')}</p>
    </div>
</div>

<script>
    import { initTerminalDemo } from '../../scripts/terminalDemo.js';

    document.addEventListener('astro:page-load', initTerminalDemo);
    if (document.readyState !== 'loading') {
        initTerminalDemo();
    } else {
        document.addEventListener('DOMContentLoaded', initTerminalDemo);
    }
</script>
