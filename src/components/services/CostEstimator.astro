---
// --- IMPORTS ---
import { getI18N } from '../../i18n/utils';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const estimator = i18n.services.estimator;
---

<!-- INTERACTIVE PROJECT CONFIGURATOR / COST ESTIMATOR -->
<div
    id="estimator"
    class="bg-gray-800/60 border border-gray-700 rounded-2xl p-6 md:p-10 mb-24"
    data-animate="fade-up"
    data-project-types={JSON.stringify(estimator.projectTypes)}
    data-reactions={JSON.stringify(estimator.reactions)}
    data-message-template={estimator.messageTemplate}
    data-no-addons-label={estimator.noAddonsLabel}
>
    <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">{estimator.title}</h2>
        <p class="text-gray-400 max-w-xl mx-auto">{estimator.subtitle}</p>
    </div>

    <div class="max-w-3xl mx-auto">
        {/* STEP 1: PROJECT TYPE */}
        <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-4">{estimator.projectTypeLabel}</h3>
        <div id="estimator-types" class="grid gap-4 sm:grid-cols-2 mb-6">
            {estimator.projectTypes.map((type) => (
                <button
                    type="button"
                    class="estimator-type flex flex-col justify-center overflow-hidden text-left bg-gray-900/60 border border-gray-700 hover:border-blue-500 rounded-xl p-5 transition-colors duration-200 h-[104px] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                    data-key={type.key}
                    aria-pressed="false"
                >
                    <p class="text-gray-200 font-semibold mb-1">{type.label}</p>
                    <p class="text-xs text-gray-500 leading-relaxed">{type.description}</p>
                </button>
            ))}
        </div>

        {/* QUANTITY STEPPER (revealed once a project type is chosen) */}
        <div id="estimator-quantity" class="hidden items-center justify-center gap-5 mb-10 bg-gray-900/60 border border-gray-700 rounded-xl p-4 max-w-xs mx-auto">
            <button type="button" id="estimator-qty-minus" aria-label="-" class="w-9 h-9 flex-shrink-0 rounded-full bg-gray-800 hover:bg-gray-700 text-white font-bold text-lg transition-colors">−</button>
            <div class="text-center">
                <span id="estimator-qty-value" class="text-2xl font-bold text-white font-mono block leading-none"></span>
                <span id="estimator-qty-label" class="text-xs text-gray-500 uppercase tracking-wide"></span>
            </div>
            <button type="button" id="estimator-qty-plus" aria-label="+" class="w-9 h-9 flex-shrink-0 rounded-full bg-gray-800 hover:bg-gray-700 text-white font-bold text-lg transition-colors">+</button>
        </div>

        {/* STEP 2: ADD-ONS */}
        <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-4">{estimator.addonsLabel}</h3>
        <div id="estimator-addons" class="grid gap-3 sm:grid-cols-2 mb-8">
            {estimator.addons.map((addon) => (
                <button
                    type="button"
                    class="estimator-addon flex items-center justify-between gap-3 overflow-hidden text-left bg-gray-900/60 border border-gray-700 hover:border-blue-500 rounded-xl p-4 transition-colors duration-200 h-[92px] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                    data-key={addon.key}
                    data-label={addon.label}
                    data-price={addon.price}
                    aria-pressed="false"
                >
                    <span>
                        <span class="block text-gray-200 text-sm font-medium">{addon.label}</span>
                        <span class="block text-xs text-gray-500 mt-0.5">{addon.description}</span>
                    </span>
                    <span class="flex items-center gap-2 flex-shrink-0">
                        <span class="text-xs text-gray-500 font-mono">+€{addon.price}</span>
                        <span class="estimator-check w-5 h-5 rounded-full border-2 border-gray-600 flex items-center justify-center transition-colors duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white opacity-0 transition-opacity duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true" focusable="false">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                        </span>
                    </span>
                </button>
            ))}
        </div>

        {/* TOTAL */}
        <div class="text-center p-6 bg-gradient-to-br from-blue-950/40 to-purple-950/20 border border-blue-500/30 rounded-xl">
            <p class="text-sm text-gray-400 uppercase tracking-wide mb-2">{estimator.totalLabel}</p>
            <p class="text-3xl md:text-4xl font-bold text-white font-mono" aria-live="polite">
                <span id="estimator-empty" class="text-base text-gray-500 font-sans font-normal">{estimator.emptyLabel}</span>
                <span id="estimator-total" class="hidden">~€<span id="estimator-total-value">0</span></span>
            </p>
            <p id="estimator-reaction" class="text-sm text-blue-400 font-semibold mt-2 h-5"></p>
            <p class="text-xs text-gray-500 mt-4 mb-6 max-w-md mx-auto">{estimator.disclaimer}</p>

            <div class="flex flex-wrap justify-center gap-3">
                <button
                    type="button"
                    id="estimator-reset"
                    class="btn-premium border border-gray-600 hover:bg-gray-700 text-gray-300 font-semibold py-3 px-6 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400"
                >
                    {estimator.resetLabel}
                </button>
                <a
                    id="estimator-contact"
                    href="/#contact"
                    class="btn-premium hidden bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 focus-visible:ring-white"
                >
                    {estimator.contactLabel}
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    import { initCostEstimator } from '../../scripts/costEstimator.js';

    document.addEventListener('astro:page-load', initCostEstimator);
    if (document.readyState !== 'loading') {
        initCostEstimator();
    } else {
        document.addEventListener('DOMContentLoaded', initCostEstimator);
    }
</script>
