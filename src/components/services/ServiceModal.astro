---
// --- IMPORTS ---
import { getI18N } from '../../i18n/utils';
import ServiceIcon from '../icons/ServiceIcon.astro';
import type { ServiceIconName } from '../../types/services';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const modal = i18n.services.modal;
const services = i18n.services.list;
---

<!-- SHARED SERVICE DETAIL MODAL (populated via JS from the clicked card) -->
<div
    id="service-modal-overlay"
    class="toc-modal-overlay hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="service-modal-title"
>
    <div class="toc-modal-panel w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-gray-800 border border-gray-700 rounded-2xl shadow-2xl p-8 md:p-10">
        <div class="flex items-start justify-between gap-4 mb-6">
            <div class="flex items-center gap-4">
                <div id="service-modal-icon" class="flex-shrink-0 flex items-center justify-center w-14 h-14 rounded-xl bg-blue-500/10 text-blue-400"></div>
                <div>
                    <h2 id="service-modal-title" class="text-2xl font-bold text-white"></h2>
                    <p id="service-modal-tagline" class="text-blue-400 text-sm font-semibold"></p>
                </div>
            </div>
            <button id="service-modal-close" aria-label={modal.closeLabel} class="text-gray-400 hover:text-white transition-colors flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <p id="service-modal-description" class="text-gray-300 text-lg leading-relaxed mb-8"></p>

        <div class="grid gap-8 sm:grid-cols-2 mb-8">
            <div>
                <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-3">{modal.idealForLabel}</h3>
                <ul id="service-modal-idealfor" class="space-y-2"></ul>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-3">{modal.includesLabel}</h3>
                <ul id="service-modal-includes" class="space-y-2"></ul>
            </div>
        </div>

        <a
            id="service-modal-cta"
            href="/#contact"
            class="btn-premium block text-center bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-6 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 focus-visible:ring-white"
        >
            {modal.ctaLabel}
        </a>
    </div>
</div>

{/* Icon templates: hidden, cloned into service-modal-icon by JS (keeps the icon set server-rendered) */}
<div id="service-modal-icon-templates" class="hidden" aria-hidden="true">
    {services.map((service) => (
        <div data-icon-template={service.icon}>
            <ServiceIcon name={service.icon as ServiceIconName} class="w-6 h-6" />
        </div>
    ))}
</div>

<script>
    import { initServiceModal } from '../../scripts/serviceModal.js';

    document.addEventListener('astro:page-load', initServiceModal);
    if (document.readyState !== 'loading') {
        initServiceModal();
    } else {
        document.addEventListener('DOMContentLoaded', initServiceModal);
    }
</script>
