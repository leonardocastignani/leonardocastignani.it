---
// --- IMPORTS ---
import { getI18N } from '../../i18n/utils';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const quiz = i18n.services.quiz;
const servicesList = i18n.services.list;
---

<!-- SERVICES QUIZ / CONFIGURATOR -->
<div
    id="services-quiz"
    class="bg-gray-800/60 border border-gray-700 rounded-2xl p-6 md:p-10 mb-24"
    data-animate="scale"
    data-services={JSON.stringify(servicesList.map((s) => ({ slug: s.slug, title: s.title, tagline: s.tagline, description: s.description })))}
>
    <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">{quiz.title}</h2>
        <p class="text-gray-400 max-w-xl mx-auto">{quiz.subtitle}</p>
    </div>

    {/* PROGRESS DOTS */}
    <div class="flex justify-center gap-2 mb-8" aria-hidden="true">
        {quiz.questions.map((_, i) => (
            <span class="quiz-dot w-2.5 h-2.5 rounded-full bg-gray-600 transition-colors duration-300" data-dot={i}></span>
        ))}
    </div>

    {/* QUESTIONS */}
    <div id="quiz-questions">
        {quiz.questions.map((q, qIndex) => (
            <div class="quiz-question" data-question={qIndex} hidden={qIndex !== 0}>
                <h3 class="text-lg md:text-xl font-semibold text-white text-center mb-6">{q.question}</h3>
                <div class="grid sm:grid-cols-2 gap-3 max-w-2xl mx-auto">
                    {q.answers.map((a) => (
                        <button
                            type="button"
                            class="quiz-answer text-left p-4 bg-gray-900/60 border border-gray-700 hover:border-blue-500 hover:bg-gray-900 rounded-xl text-gray-200 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                            data-service={a.service}
                        >
                            {a.label}
                        </button>
                    ))}
                </div>
            </div>
        ))}
    </div>

    {/* RESULT */}
    <div id="quiz-result" hidden class="text-center max-w-xl mx-auto" role="status" aria-live="polite">
        <p class="text-gray-400 mb-3">{quiz.resultIntro}</p>
        <h3 id="quiz-result-title" class="text-2xl font-bold text-white mb-2"></h3>
        <p id="quiz-result-tagline" class="text-blue-400 font-semibold mb-4"></p>
        <p id="quiz-result-description" class="text-gray-300 leading-relaxed mb-6"></p>
        <div class="flex flex-wrap justify-center gap-3">
            <a id="quiz-result-cta" href="#" class="btn-premium bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 focus-visible:ring-white">
                {quiz.resultCtaLabel}
            </a>
            <button type="button" id="quiz-restart" class="btn-premium border border-gray-600 hover:bg-gray-700 text-gray-300 font-semibold py-3 px-6 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400">
                {quiz.restartLabel}
            </button>
        </div>
    </div>
</div>

<script>
    import { initServicesQuiz } from '../../scripts/servicesQuiz.js';

    document.addEventListener('astro:page-load', initServicesQuiz);
    if (document.readyState !== 'loading') {
        initServicesQuiz();
    } else {
        document.addEventListener('DOMContentLoaded', initServicesQuiz);
    }
</script>
