---
// --- IMPORTS ---
import { getI18N } from '../../i18n/utils';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const beforeAfter = i18n.services.beforeAfter;

// Icons mapped by stat position (LCP/speed, page weight, HTTP requests) — the
// 3 stats are a fixed, hand-authored set (not user-generated), so indexing is safe.
const STAT_ICON_PATHS = [
    'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
    'M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9',
    'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99',
];
---

<!-- BEFORE / AFTER ANIMATED STATS -->
<div class="mb-24" data-animate="fade-up">
    <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">{beforeAfter.title}</h2>
        <p class="text-gray-400 max-w-xl mx-auto">{beforeAfter.subtitle}</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-3 max-w-4xl mx-auto" data-stagger-children="120">
        {beforeAfter.stats.map((stat, index) => (
            <div
                class="stat-counter card-tilt spotlight bg-gray-800/60 border border-gray-700 hover:border-blue-500 rounded-xl p-6 text-center transition-colors duration-200"
                data-animate="fade-up"
                data-tilt-max="3"
                data-before={stat.before}
                data-after={stat.after}
                data-suffix={stat.suffix}
                data-decimals={stat.decimals}
            >
                <div class="mx-auto mb-3 flex items-center justify-center w-11 h-11 rounded-xl bg-blue-500/10 text-blue-400" style="transform: translateZ(20px);">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d={STAT_ICON_PATHS[index]} />
                    </svg>
                </div>

                <p class="text-sm text-gray-400 mb-4">{stat.label}</p>

                <div class="flex items-center justify-center gap-2">
                    <span class="text-[11px] text-gray-500 uppercase tracking-wide">{beforeAfter.beforeLabel}</span>
                    <span class="text-lg text-gray-500 font-mono line-through">{stat.before}{stat.suffix}</span>
                </div>

                <div class="flex items-center justify-center gap-2 mt-2">
                    <span class="text-[11px] text-blue-400 uppercase tracking-wide font-semibold">{beforeAfter.afterLabel}</span>
                    <span class="text-3xl font-bold text-white font-mono"><span class="stat-number">{stat.before}</span>{stat.suffix}</span>
                </div>
            </div>
        ))}
    </div>

    <p class="text-xs text-gray-500 text-center mt-6 max-w-md mx-auto">{beforeAfter.disclaimer}</p>
</div>

<script>
    import { initBeforeAfterStats } from '../../scripts/beforeAfterStats.js';

    document.addEventListener('astro:page-load', initBeforeAfterStats);
    if (document.readyState !== 'loading') {
        initBeforeAfterStats();
    } else {
        document.addEventListener('DOMContentLoaded', initBeforeAfterStats);
    }
</script>
