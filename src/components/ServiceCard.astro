---
// --- IMPORTS ---
import ServiceIcon from './icons/ServiceIcon.astro';
import type { ServiceIconName } from '../types/services';

// --- PROPS ---
interface Props {
    slug: string;
    icon: ServiceIconName;
    title: string;
    tagline: string;
    description: string;
    features: string[];
    idealFor: string[];
    includes: string[];
    detailsLabel: string;
}
const { slug, icon, title, tagline, description, features, idealFor, includes, detailsLabel } = Astro.props;

const modalDetail = JSON.stringify({ slug, icon, title, tagline, description, idealFor, includes });
---

<!-- SERVICE CARD (clickable: opens the shared detail modal) -->
<div
    id={`service-${slug}`}
    data-service-card={slug}
    data-service-detail={modalDetail}
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    class="service-card card-tilt spotlight relative bg-gray-800 border border-gray-700 hover:border-blue-500 rounded-2xl p-8 shadow-xl h-full flex flex-col scroll-mt-28 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
    data-animate="fade-up"
    data-tilt-max="2"
>
    <div class="mb-5 flex items-center justify-center w-14 h-14 rounded-xl bg-blue-500/10 text-blue-400" style="transform: translateZ(20px);">
        <ServiceIcon name={icon} class="w-7 h-7" />
    </div>

    <h3 class="text-xl font-bold text-white mb-1">{title}</h3>
    <p class="text-blue-400 text-sm font-semibold mb-4">{tagline}</p>
    <p class="text-gray-300 leading-relaxed mb-6">{description}</p>

    <ul class="space-y-2.5 mb-6">
        {features.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>{feature}</span>
            </li>
        ))}
    </ul>

    <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-blue-400">
        {detailsLabel}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
    </span>
</div>
