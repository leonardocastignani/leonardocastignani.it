---
// --- IMPORTS ---
import { getI18N } from '../i18n/utils';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import XIcon from './icons/XIcon.astro';
import WhatsappIcon from './icons/WhatsappIcon.astro';
import MailIcon from './icons/MailIcon.astro';
import LinkIcon from './icons/LinkIcon.astro';

// --- PROPS ---
interface Props {
    title: string;
}
const { title } = Astro.props;
const i18n = getI18N({ astroUrl: Astro.url });

const canonicalURL = Astro.url.href;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`;
const xHref = `https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalURL)}&text=${encodeURIComponent(title)}`;
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title} ${canonicalURL}`)}`;
const emailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(canonicalURL)}`;
---

<!-- SHARE BUTTONS (repeated boilerplate: excluded from search index) -->
<div class="flex flex-wrap items-center justify-center gap-3 my-10" data-pagefind-ignore>
    <span class="text-sm text-gray-400 font-semibold w-full text-center sm:w-auto">{i18n.blog.shareLabel}</span>

    {/* NATIVE SHARE (progressive enhancement: shown only if the OS/browser share sheet is available) */}
    <button
        type="button"
        id="share-native-btn"
        data-title={title}
        data-url={canonicalURL}
        aria-label={i18n.blog.shareNative}
        title={i18n.blog.shareNative}
        class="hidden items-center justify-center w-9 h-9 rounded-full bg-blue-600 hover:bg-blue-500 text-white transition-all duration-200 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 [&_svg]:w-4 [&_svg]:h-4"
    >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" />
        </svg>
    </button>

    <a
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={i18n.blog.shareLinkedin}
        title={i18n.blog.shareLinkedin}
        class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-800 border border-gray-700 hover:border-blue-500 hover:-translate-y-0.5 transition-all duration-200 [&_svg]:w-4 [&_svg]:h-4"
    >
        <LinkedinIcon />
    </a>

    <a
        href={xHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={i18n.blog.shareX}
        title={i18n.blog.shareX}
        class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-800 border border-gray-700 text-gray-300 hover:text-white hover:border-blue-500 hover:-translate-y-0.5 transition-all duration-200 [&_svg]:w-4 [&_svg]:h-4"
    >
        <XIcon />
    </a>

    <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={i18n.blog.shareWhatsapp}
        title={i18n.blog.shareWhatsapp}
        class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-800 border border-gray-700 text-[#25D366] hover:border-[#25D366] hover:-translate-y-0.5 transition-all duration-200 [&_svg]:w-4 [&_svg]:h-4"
    >
        <WhatsappIcon />
    </a>

    <a
        href={emailHref}
        aria-label={i18n.blog.shareEmail}
        title={i18n.blog.shareEmail}
        class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-800 border border-gray-700 text-gray-300 hover:text-white hover:border-blue-500 hover:-translate-y-0.5 transition-all duration-200 [&_svg]:w-4 [&_svg]:h-4"
    >
        <MailIcon />
    </a>

    <button
        type="button"
        id="share-copy-btn"
        data-url={canonicalURL}
        data-copied-label={i18n.blog.shareCopied}
        data-default-label={i18n.blog.shareCopy}
        aria-label={i18n.blog.shareCopy}
        title={i18n.blog.shareCopy}
        class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-800 border border-gray-700 text-gray-300 hover:text-white hover:border-blue-500 hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 [&_svg]:w-4 [&_svg]:h-4"
    >
        <LinkIcon />
    </button>
</div>

<script>
    import { initShareCopy } from '../scripts/shareCopy.js';
    import { initNativeShare } from '../scripts/nativeShare.js';

    function initShareButtons() {
        initShareCopy();
        initNativeShare();
    }

    document.addEventListener('astro:page-load', initShareButtons);
    if (document.readyState !== 'loading') {
        initShareButtons();
    } else {
        document.addEventListener('DOMContentLoaded', initShareButtons);
    }
</script>
