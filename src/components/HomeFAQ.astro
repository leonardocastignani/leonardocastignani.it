---
// --- IMPORTS ---
import { getI18N } from '../i18n/utils';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const titleId = "home-faq-title";
const items: { question: string; answer: string; href: string }[] = i18n.homeFaq.items;

// --- JSON-LD SCHEMA (FAQPage rich snippet + GEO/RAG reinforcement) ---
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": items.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
        }
    }))
};
---

<!-- HOME FAQ (rendered inside the shared #latest-posts section, see Layout usage) -->
<div class="container mx-auto max-w-3xl text-center mt-20 pt-16 border-t border-gray-700/50">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <h2 id={titleId} class="text-3xl md:text-4xl font-bold mb-3">{i18n.homeFaq.title}</h2>
    <p class="text-gray-400 max-w-2xl mx-auto mb-12">{i18n.homeFaq.subtitle}</p>

    <div class="text-left space-y-4">
        {items.map((item) => (
            <details name="home-faq" class="group bg-gray-900/60 border border-gray-700 rounded-xl p-5 open:border-blue-500/50 transition-colors">
                <summary class="flex items-center justify-between gap-4 font-semibold text-white cursor-pointer list-none">
                    <span>{item.question}</span>
                    <svg class="w-5 h-5 flex-shrink-0 text-blue-400 transition-transform duration-300 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                </summary>
                <p class="mt-3 text-gray-300 leading-relaxed">{item.answer}</p>
                <a href={item.href} class="inline-block mt-3 text-sm font-semibold text-blue-400 hover:text-blue-300">
                    {i18n.homeFaq.readMore} &rarr;
                </a>
            </details>
        ))}
    </div>
</div>
