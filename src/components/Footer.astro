---
// --- IMPORTS ---
import { Image } from 'astro:assets';
import { getI18N, getLangFromUrl } from '../i18n/utils';
import { SITE_DATA, SOCIAL_LINKS } from '../consts';
import { social } from '../data/social';
import SocialLink from './SocialLink.astro';
import WhatsappIcon from './icons/WhatsappIcon.astro';
import logo from '../assets/logo.svg';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const currentLang = getLangFromUrl(Astro.url);
const privacyHref = currentLang === 'it' ? '/privacy-policy/' : '/en/privacy-policy/';
const buildYear = new Date().getFullYear();

// --- DYNAMIC LOCAL SEO TEXT ---
const geoText = currentLang === 'it'
    ? "Sviluppatore Web e Software operativo nelle Marche e disponibile da remoto."
    : "Web and Software Developer based in Marche, Italy. Available for remote work.";

// --- QUICK LINKS (same homepage-anchor logic used by Header.astro, so these
// resolve correctly from any page, not just the homepage) ---
const homeBase = i18n.nav.homeLink === '/' ? '' : i18n.nav.homeLink.replace(/\/$/, '');
const quickLinks = [
    { href: `${homeBase}/#home`, label: i18n.nav.home },
    { href: `${homeBase}/#about`, label: i18n.nav.about },
    { href: `${homeBase}/#education`, label: i18n.nav.education },
    { href: `${homeBase}/#experience`, label: i18n.nav.experience },
    { href: `${homeBase}/#projects`, label: i18n.nav.projects },
    { href: i18n.nav.servicesLink, label: i18n.nav.services },
    { href: i18n.nav.blogLink, label: i18n.nav.blog },
];

// --- DIRECT CONTACT LINKS ---
const whatsappHref = `https://api.whatsapp.com/send?phone=${SITE_DATA.whatsappNumber}&text=${i18n.whatsapp.message}`;
---

<!-- FOOTER SECTION -->
<footer class="relative bg-slate-50 border-t border-slate-200/60 pt-8 pb-4 overflow-hidden">
    {/* BRAND ACCENT BAR */}
    <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500" aria-hidden="true"></div>

    <div class="container mx-auto max-w-6xl px-4">
        <div class="flex flex-col items-center sm:flex-row sm:items-start sm:justify-between gap-8 sm:gap-10 text-center sm:text-left" data-stagger-children="100">

            {/* COLUMN 1: BRAND */}
            <div class="sm:max-w-md" data-animate="fade-up">
                <a href={i18n.nav.homeLink} class="inline-flex items-center gap-2 text-lg font-bold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
                    <Image src={logo} alt="" class="h-7 w-auto" />
                    <span>{SITE_DATA.name}</span>
                </a>
                <p class="text-sm text-gray-600 leading-relaxed mb-3">
                    {i18n.footer.tagline}
                </p>
                <div class="grid grid-cols-3 gap-1.5 w-fit mx-auto sm:mx-0">
                    {social.map(({ name, Icon, id, disabled }: { name: string; Icon: any; id: string; disabled?: boolean }) => (
                        <SocialLink
                            href={SOCIAL_LINKS[id as keyof typeof SOCIAL_LINKS] || '#'}
                            name={name}
                            Icon={Icon}
                            ariaLabel={`${i18n.footer.socialAriaLabel} ${name}`}
                            disabled={disabled}
                            unavailableLabel={i18n.footer.socialUnavailable}
                        />
                    ))}
                </div>
            </div>

            {/* COLUMN 2: QUICK LINKS */}
            <div data-animate="fade-up">
                <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">{i18n.footer.quickLinksTitle}</h3>
                <ul class="space-y-2.5">
                    {quickLinks.map(link => (
                        <li>
                            <a href={link.href} class="group relative inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors">
                                <svg class="absolute left-0 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
                                </svg>
                                <span class="nav-link-underline relative inline-block transition-transform duration-200 ease-out group-hover:translate-x-5">{link.label}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            {/* COLUMN 3: CONTACT */}
            <div data-animate="fade-up">
                <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">{i18n.footer.contactTitle}</h3>
                <ul class="space-y-2.5 mb-5">
                    <li>
                        <a href={SOCIAL_LINKS.email} class="nav-link-underline inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition-colors">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0a2.25 2.25 0 0 0-2.25-2.25h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                            </svg>
                            <span>{SITE_DATA.email}</span>
                        </a>
                    </li>
                    <li>
                        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="nav-link-underline inline-flex items-center gap-2 text-sm text-gray-600 hover:text-[#25D366] transition-colors">
                            <WhatsappIcon class="w-4 h-4 flex-shrink-0" />
                            <span>{i18n.whatsapp.tooltip}</span>
                        </a>
                    </li>
                </ul>
                <a
                    href={`${homeBase}/#contact`}
                    class="btn-premium magnetic inline-block bg-blue-600 hover:bg-blue-500 hover:shadow-[0_10px_30px_-8px_rgba(59,130,246,0.55)] text-white text-sm font-bold py-2.5 px-5 rounded-lg transition-colors focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 focus-visible:ring-blue-600"
                    data-magnetic-strength="0.2"
                >
                    {i18n.hero.contact}
                </a>
            </div>
        </div>

        {/* BOTTOM BAR */}
        <div class="mt-6 pt-4 border-t border-slate-200/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
            <div>
                <p id="copyright-text" class="text-sm text-gray-600">
                    {i18n.footer.copyright.replace('{year}', buildYear.toString())}
                </p>
                <p class="text-xs text-gray-600 mt-1">
                    {geoText}
                </p>
            </div>

            <a
                href={privacyHref}
                class="nav-link-underline text-sm text-gray-600 hover:text-gray-900 underline underline-offset-2 transition-colors"
            >
                {i18n.footer.privacyLink}
            </a>
        </div>
    </div>
</footer>

<style>
    /* Keep the quick-link underline active for the link's whole hit area
       (including the arrow, which sits outside the underlined word itself). */
    .group:hover .nav-link-underline::after {
        transform: scaleX(1);
        transform-origin: left;
    }
</style>

<!-- CLIENT-SIDE SCRIPTS -->
<script>
    const copyrightElement = document.getElementById('copyright-text');
    if (copyrightElement) {
        const currentYear = new Date().getFullYear().toString();
        copyrightElement.innerText = copyrightElement.innerText.replace(/\d{4}/, currentYear);
    }
</script>
