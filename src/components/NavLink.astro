---
// --- INITIAL CONFIGURATION ---
const { href, label, sectionId } = Astro.props;
const { pathname } = Astro.url;

const isHashLink = href.includes('#');

const isActive = !isHashLink && (href === pathname || (href !== '/' && pathname.startsWith(href)));
---

<!-- NAVIGATION LINK COMPONENT -->
<a
    href={href}
    data-nav-link
    data-section={sectionId}
    class:list={[
        "nav-link-underline transition-colors duration-300 font-medium text-sm md:text-base",
        isActive ? "text-gray-900" : "text-gray-500 hover:text-gray-900",
        "data-[active=true]:text-gray-900"
    ]}
>
    {label}
</a>