---
// --- IMPORTS ---
import { Image } from 'astro:assets';
import { getI18N } from '../i18n/utils';
import NavLink from './NavLink.astro';
import ItalyFlagIcon from './icons/ItalyFlagIcon.astro';
import UkFlagIcon from './icons/UkFlagIcon.astro';
import logo from '../assets/logo.svg';

// --- INITIAL CONFIGURATION ---
const { isMaintenance = false, alternateItPath, alternateEnPath } = Astro.props;
const i18n = getI18N({ astroUrl: Astro.url });
const homeBase = i18n.nav.homeLink === '/' ? '' : i18n.nav.homeLink.replace(/\/$/, '');

// --- NAVIGATION MENU DEFINITION ---
const navLinks = [
    { href: `${homeBase}/#home`, label: i18n.nav.home },
    { href: `${homeBase}/#about`, label: i18n.nav.about },
    { href: `${homeBase}/#education`, label: i18n.nav.education },
    { href: `${homeBase}/#experience`, label: i18n.nav.experience },
    { href: `${homeBase}/#projects`, label: i18n.nav.projects },
    { href: i18n.nav.servicesLink, label: i18n.nav.services, sectionId: 'services' },
    { href: i18n.nav.blogLink, label: i18n.nav.blog, sectionId: 'latest-posts' },
    { href: `${homeBase}/#contact`, label: i18n.nav.contact },
];

// --- SMART LANGUAGE SWITCHING LOGIC ---
const currentPath = Astro.url.pathname;
let targetLangLink = '';
let targetLangFlag = '';
let targetLangAria = '';

const isBlogPage = currentPath.includes('/blog');
const isServicesPage = currentPath === '/servizi/' || currentPath === '/en/services/';
// Astro genera 404.astro come /404.html "nudo" (niente trailing slash, niente
// cartella), a differenza di ogni altra pagina sotto trailingSlash: 'always'
// (incluso /en/404/, che segue la regola normale). La logica generica sotto
// si limiterebbe a togliere "/en" da "/en/404/" ottenendo "/404/", un URL che
// non esiste. Va quindi gestito qui come caso a parte, puntando esplicitamente
// a "/404.html": l'estensione esplicita serve sia in locale (astro dev/preview,
// che con trailingSlash: 'always' rifiuta "/404" senza slash) sia in produzione
// (dove Netlify la risolverebbe comunque implicitamente).
const isNotFoundPage = currentPath === '/404/' || currentPath === '/en/404/';

if (isNotFoundPage) {
    if (currentPath.startsWith('/en/')) {
        targetLangLink = '/404.html';
        targetLangFlag = 'it';
        targetLangAria = 'IT - Passa alla versione italiana';
    } else {
        targetLangLink = '/en/404/';
        targetLangFlag = 'gb';
        targetLangAria = 'EN - Switch to English version';
    }
} else if (isBlogPage) {
    // Prefer the article's own translated URL (from its alternateSlug in the
    // frontmatter, already resolved by Layout.astro) over the generic blog
    // listing, so switching language on a post opens its actual translation.
    if (currentPath.startsWith('/en/')) {
        targetLangLink = alternateItPath || '/blog/';
        targetLangFlag = 'it';
        targetLangAria = 'IT - Passa alla versione italiana';
    } else {
        targetLangLink = alternateEnPath || '/en/blog/';
        targetLangFlag = 'gb';
        targetLangAria = 'EN - Switch to English version';
    }
} else if (isServicesPage) {
    if (currentPath.startsWith('/en/')) {
        targetLangLink = '/servizi/';
        targetLangFlag = 'it';
        targetLangAria = 'IT - Passa alla versione italiana';
    } else {
        targetLangLink = '/en/services/';
        targetLangFlag = 'gb';
        targetLangAria = 'EN - Switch to English version';
    }
} else {
    if (currentPath.startsWith('/en/')) {
        const pathWithoutEn = currentPath.replace(/^\/en/, '');
        targetLangLink = pathWithoutEn || '/';
        targetLangFlag = 'it';
        targetLangAria = 'IT - Passa alla versione italiana';
    } else {
        targetLangLink = currentPath === '/' ? '/en/' : `/en${currentPath}`;
        targetLangFlag = 'gb';
        targetLangAria = 'EN - Switch to English version';
    }
}

// Accessibility labels
const openMenuLabel = i18n.nav.openMenu;
const closeMenuLabel = i18n.nav.closeMenu;
const logoClasses = "text-xl font-bold flex items-center gap-x-3";
---

<!-- MAIN HEADER -->
<header id="site-header" class="bg-white/65 backdrop-blur-sm fixed z-50 border-b border-slate-200/60">
    <nav class="container mx-auto max-w-6xl px-4 py-4 flex justify-between items-center">
        {/* SITE LOGO */}
        {!isMaintenance ? (
            <a href={i18n.nav.homeLink} id="header-title" class:list={[logoClasses, "hover:text-blue-600 transition-colors"]}>
                <Image src={logo} alt="Logo di Leonardo Castignani" class="h-8 w-auto" loading="eager" />
                <span>Leonardo Castignani</span>
            </a>
        ) : (
            <div id="header-title" class:list={[logoClasses]}>
                <Image src={logo} alt="Logo di Leonardo Castignani" class="h-8 w-auto" loading="eager" />
                <span>Leonardo Castignani</span>
            </div>
        )}

        {/* NAVIGATION MENU */}
        {!isMaintenance && (
            <>
                {/* DESKTOP VERSION (raised to lg: 8 links + language switch don't
                     comfortably fit at md, which also caused overlap/overflow on
                     phones in landscape — those need the compact menu too) */}
                <div class="hidden lg:flex items-center gap-6">
                    {navLinks.map(link => (
                        <NavLink
                            href={link.href}
                            label={link.label}
                            sectionId={link.sectionId}
                            class="text-gray-600 hover:text-gray-900"
                        />
                    ))}
                    {/* Desktop Language Switcher */}
                    <a href={targetLangLink} hreflang={currentPath.startsWith('/en/') ? 'it' : 'en'} class="flex items-center bg-slate-100 hover:bg-slate-200 p-1.5 rounded-md transition-colors" aria-label={targetLangAria}>
                        {targetLangFlag === 'it' ? (
                            <ItalyFlagIcon class="w-5 h-3.5 rounded-xs" preserveAspectRatio="none" aria-hidden="true" />
                        ) : (
                            <UkFlagIcon class="w-5 h-3.5 rounded-xs" preserveAspectRatio="none" aria-hidden="true" />
                        )}
                    </a>
                </div>

                {/* MOBILE/COMPACT VERSION (below lg: includes phones in landscape) */}
                <div class="lg:hidden flex items-center gap-4">
                    {/* Mobile Language Switcher */}
                    <a href={targetLangLink} hreflang={currentPath.startsWith('/en/') ? 'it' : 'en'} class="flex items-center bg-slate-100 hover:bg-slate-200 p-2 rounded-md mt-2 transition-colors" aria-label={targetLangAria}>
                        {targetLangFlag === 'it' ? (
                            <ItalyFlagIcon class="w-6 h-4 rounded-xs" preserveAspectRatio="none" aria-hidden="true" />
                        ) : (
                            <UkFlagIcon class="w-6 h-4 rounded-xs" preserveAspectRatio="none" aria-hidden="true" />
                        )}
                    </a>
                    <button id="menu-btn" class="text-gray-700 focus:outline-hidden" aria-label={openMenuLabel} aria-expanded="false" aria-controls="mobile-menu" data-label-open={openMenuLabel} data-label-close={closeMenuLabel}>
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
                    </button>
                </div>
            </>
        )}
    </nav>

    {/* MOBILE DROPDOWN MENU */}
    {!isMaintenance && (
        <div id="mobile-menu" class="hidden lg:hidden bg-white/95 backdrop-blur-sm mobile-menu-panel">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 flex flex-col items-center">
                {navLinks.map(link => (
                    <NavLink
                        href={link.href}
                        label={link.label}
                        sectionId={link.sectionId}
                        class="text-gray-600 hover:text-gray-900 block px-3 py-2 rounded-md text-base font-medium"
                    />
                ))}
            </div>
        </div>
    )}
</header>

<!-- CLIENT-SIDE SCRIPTS -->
<script>
    import { initMobileMenu } from '../scripts/mobileMenu.js';
    import { initActiveSection } from '../scripts/activeSection.js';

    function initHeaderScripts() {
        initMobileMenu();
        initActiveSection();
    }

    document.addEventListener('DOMContentLoaded', initHeaderScripts);
    document.addEventListener('astro:after-swap', initHeaderScripts);
</script>