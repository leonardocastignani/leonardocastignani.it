---
// --- INITIAL CONFIGURATION ---
interface Props {
  name: string;
  Icon: any;
  iconClass?: string;
}
const { name, Icon, iconClass = '' } = Astro.props;
---

<!-- SKILL ICON COMPONENT -->
<div class="group relative flex flex-col items-center justify-center p-2">
  {/* ICON CONTAINER */}
  <div class:list={["w-12 h-12 text-gray-700 group-hover:text-gray-900 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] transform group-hover:scale-125 group-hover:-rotate-6", iconClass]}>
    <Icon class="w-full h-full" />
  </div>

  {/* TOOLTIP */}
  <div class="absolute -top-10 left-1/2 -translate-x-1/2 px-3 py-1 bg-slate-100 text-gray-900 text-xs font-semibold rounded-sm opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap shadow-xl z-10 capitalize translate-y-2 group-hover:translate-y-0">
    {name}
    <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-slate-100 rotate-45"></div>
  </div>
</div>