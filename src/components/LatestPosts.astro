---
// --- IMPORTS ---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getI18N, getLangFromUrl } from '../i18n/utils';
import { getReadingTime } from '../scripts/readingTime.js';

// --- INITIAL CONFIGURATION ---
const i18n = getI18N({ astroUrl: Astro.url });
const lang = getLangFromUrl(Astro.url);
const titleId = "latest-posts-title";

const blogIndexHref = lang === 'en' ? '/en/blog/' : '/blog/';
const postHref = (post: CollectionEntry<'blog'>) =>
    lang === 'en'
        ? `/en/blog/${post.id.replace(/^en\//, '')}/`
        : `/blog/${post.id.replace(/^it\//, '')}/`;

const latestPosts = (await getCollection('blog', ({ data }) => data.lang === lang))
    .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

{latestPosts.length > 0 && (
    // <!-- LATEST BLOG POSTS -->
    <div class="container mx-auto max-w-5xl text-center">
        <h2 id={titleId} class="text-3xl md:text-4xl font-bold mb-3">{i18n.blog.homeSectionTitle}</h2>
        <p class="text-gray-500 max-w-2xl mx-auto mb-12">{i18n.blog.homeSectionSubtitle}</p>

            {/* POSTS GRID */}
            <div class="grid gap-8 md:grid-cols-3 text-left" data-stagger-children="100">
                {latestPosts.map((post: CollectionEntry<'blog'>, index: number) => (
                    <a
                        href={postHref(post)}
                        data-animate="fade-up"
                        data-tilt-max="2"
                        class="card-tilt spotlight block group bg-white rounded-xl overflow-hidden border border-slate-200 hover:border-blue-500 shadow-lg"
                    >
                        {post.data.heroImage && (
                            <div class="img-reveal aspect-[16/9] w-full overflow-hidden border-b border-slate-200 bg-white">
                                <img
                                    src={post.data.heroImage}
                                    alt={post.data.imageAlt || ""}
                                    class="w-full h-full object-cover"
                                    loading={index === 0 ? "eager" : "lazy"}
                                    decoding="async"
                                    width="600"
                                    height="335"
                                />
                            </div>
                        )}
                        <div class="p-6">
                            <div class="text-sm text-blue-600 mb-2">
                                {post.data.pubDate.toLocaleDateString(i18n.blog.locale, { year: 'numeric', month: 'short', day: 'numeric' })}
                                <span aria-hidden="true"> · </span>
                                <span>{i18n.blog.readingTime.replace('{minutes}', getReadingTime(post.body).toString())}</span>
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-700 transition-colors">
                                {post.data.title}
                            </h3>
                            <p class="text-gray-500 line-clamp-3">
                                {post.data.cardDescription}
                            </p>
                        </div>
                    </a>
                ))}
            </div>

            {/* VIEW ALL LINK */}
            <div class="mt-12">
                <a
                    href={blogIndexHref}
                    class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-semibold focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:ring-blue-400 rounded-sm"
                >
                    <span>{i18n.blog.viewAllLabel}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>
    </div>
)}
